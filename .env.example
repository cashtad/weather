# Only used for a backend run directly on the host. Compose builds its own URL.
DB_URL=jdbc:postgresql://localhost:5432/weather
# Compose publishes Nginx on localhost. Change this if port 8080 is in use.
FRONTEND_PORT=8080
DB_NAME=weather
DB_USER=weather
DB_PASS=

# Required: standard Base64 encoding of at least 32 random bytes. See README.md.
JWT_SECRET=
OPENWEATHER_API_KEY=

OPENWEATHER_BASE_URL=https://api.openweathermap.org
OPENWEATHER_CONNECT_TIMEOUT=3s
OPENWEATHER_READ_TIMEOUT=10s
WEATHER_CACHE_TTL=10m
